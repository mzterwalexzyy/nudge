# === NUDGE - Environment Variables ===

# Groq is the default $0 completion provider for this build.
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional provider swap (no other code changes required).
GEMINI_API_KEY=your_gemini_api_key_here

# Required in production. Generate at least 32 random characters and keep it secret.
SESSION_SECRET=replace_with_a_32_character_or_longer_random_secret

# Required in production. Must be the public HTTPS origin, without a trailing path.
APP_URL=https://your-nudge-domain.example

# Production must point this at durable storage. Local development may leave it empty.
DB_PATH=

# The reviewed account copied into each isolated judge demo profile.
DEMO_SOURCE_ACCOUNT_ID=local

# Optional local-only legacy extension credential. Hosted users generate a private
# connection token from Profile; never commit a real token.
SECOND_BRAIN_CAPTURE_TOKEN=replace_with_a_long_random_local_token
SECOND_BRAIN_ACCOUNT_ID=local

# Supabase production path (optional; not required for the SQLite deployment).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_KEY=your_service_key
